{
  "manifest_version": 3,
  "name": "CaptureEcran - Capture Intégrale",
  "version": "1.0.0",
  "description": "Capturez l'intégralité d'une page web en un clic. Export PNG, JPEG ou PDF.",
  "default_locale": "fr",
  
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "notifications"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "CaptureEcran - Capturer cette page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
{
  "manifest_version": 3,
  "name": "CaptureEcran Pro - Capture & Annotation",
  "version": "2.0.0",
  "description": "Extension professionnelle de capture d'écran : capture complète, sélection, annotations, historique et export multi-formats",
  "default_locale": "fr",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "notifications",
    "clipboardWrite",
    "debugger"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CaptureEcran Pro - Capturer (Ctrl+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/selection-overlay.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "capture-full": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capturer la page complète"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Capturer la zone visible"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Sélectionner une zone à capturer"
    },
    "open-history": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Ouvrir l'historique des captures"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["editor/editor.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
